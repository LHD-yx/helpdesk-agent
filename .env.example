# ============================================================
#  复制本文件为 .env，填入你自己的 key。
#  .env 已被 .gitignore 忽略，永远不会进入 git。
# ============================================================

# ===== LLM 供应商 =====
# 可选：deepseek | siliconflow | siliconflow-free | ollama
# 换供应商只改这一行（前提是 LLM_API_KEY 对应那一家）。
LLM_PROVIDER=deepseek

# 去平台后台创建。只填在这里，不要提交、不要贴到任何聊天窗口。
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 下面两项留空 = 使用 app/config.py 里的预设；
# 想临时指向别的模型（比如硅基流动上的某个模型），就在这里显式写。
LLM_BASE_URL=
LLM_MODEL=

LLM_TEMPERATURE=0.2
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2

# ===== 备用供应商（可选）=====
# 主供应商调用失败时自动切到这里。留空 = 不启用降级。
# 典型用法：主力用 DeepSeek，备用挂硅基流动的免费模型。
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_API_KEY=

# ===== 应用 =====
APP_ENV=dev
LOG_LEVEL=INFO
